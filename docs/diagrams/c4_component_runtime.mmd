C4Component
title Runtime owner component view
Container(PublicAPI, "Public API facade", "lib/src/api/", "Wrapper exports and named facade bridges.")
Container(ContractsPublic, "Public contracts", "lib/src/contracts/public/", "Stable DTOs, operations, events, errors, runtime state, and public ports.")
Container(ContractsInternal, "Internal contracts", "lib/src/contracts/internal/", "Owner ports, immutable facts, delivery effects, and guard seams.")
Container(RuntimeRoot, "RuntimeRoot", "lib/src/runtime/", "Composition root for document, edit, interaction, frame, spatial, resource, codec, and diagnostic services.")
Container_Boundary(runtime_components, "RuntimeRoot internals") {
  Component(DocumentStoreKernel, "DocumentStoreKernel", "lib/src/store/", "Committed document state, document revisions, resource descriptors, and projection cache.")
  Component(FrameFactsPort, "FrameFactsPort", "query boundary", "Intent-specific immutable committed frame facts for frame capture, row resolution, and descriptor snapshots.")
  Component(SelectionKernel, "SelectionKernel", "lib/src/selection/", "Runtime selected ids, selectionRevision, normalization, and content-only filtering.")
  Component(SelectionFactsPort, "SelectionFactsPort", "query boundary", "Intent-specific immutable selection facts for interaction and frame capture.")
  Component(EditKernel, "EditKernel", "lib/src/edit/", "Synchronous edit sessions with draft, touched-set, commit, and rollback ownership.")
  Component(InteractionEngine, "InteractionEngine", "lib/src/interaction/", "Pointer sessions, tool state, previews, and terminal edit requests.")
  Component(InteractionReadPort, "InteractionReadPort", "query boundary", "Read-only interaction facts: hit/order facts, element snapshots, bounds, generation, revision, family, epoch, visibility, and top-hit status.")
  Component(PointerToolCleanupCoordinator, "PointerToolCleanupCoordinator", "lib/src/interaction/", "Target internal InteractionEngine collaborator for shared pointer cleanup policy and effect-only outcomes.")
  Component(FrameEngine, "FrameEngine", "lib/src/frame/", "Frame-internal facade for orchestration, painter input assembly, and repaint buses.")
  Component(FrameCaptureService, "FrameCaptureService", "lib/src/frame/", "Frame-private capture owner for CapturedMainFrame and CapturedOverlayFrame.")
  Component(OrdinaryPaintPlanner, "OrdinaryPaintPlanner", "lib/src/frame/", "Ordinary committed render-record cache owner.")
  Component(SelectedMoveSupplementPlanner, "SelectedMoveSupplementPlanner", "lib/src/frame/", "Per-frame selected move supplement owner.")
  Component(SelectionDecorationPlanner, "SelectionDecorationPlanner", "lib/src/frame/", "Selection decoration key owner including boundsRevision.")
  Component(PaintAssetBindingService, "PaintAssetBindingService", "lib/src/frame/", "Descriptor-to-asset binding owner through explicit SurfaceResourceSession.")
  Component(StaticBackgroundPlanner, "StaticBackgroundPlanner", "lib/src/frame/", "Static background/grid plan and cache identity owner.")
  Component(OverlayPreviewPlanner, "OverlayPreviewPlanner", "lib/src/frame/", "Immutable overlay primitive admission owner.")
  Component(SpatialKernel, "SpatialKernel", "lib/src/geometry/", "Hit testing, bounds, and spatial indexes derived from document state.")
  Component(ResourceKernel, "ResourceKernel", "lib/src/resources/", "Resource API, dirty resource ids, public resource visual state, and session invalidation events.")
  Component(SurfaceResourceSession, "SurfaceResourceSession", "lib/src/resources/", "Surface-scoped resolver reference, resolverGeneration, ImageResolveCache, budget, and same-frame suppression.")
  Component(CodecBoundary, "CodecBoundary", "lib/src/codec/", "Schema v1 JSON decode, encode, validation, and diagnostics.")
  Component(DiagnosticsHub, "DiagnosticsHub", "lib/src/diagnostics/", "Structured validation and runtime error projection.")
}
