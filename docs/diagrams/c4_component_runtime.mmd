C4Component
title Runtime owner component view
Container(PublicAPI, "Public API", "lib/src/api/", "Stable DTOs, operations, events, and errors.")
Container(RuntimeRoot, "RuntimeRoot", "lib/src/runtime/", "Composition root for document, edit, interaction, frame, spatial, resource, codec, and diagnostic services.")
Container_Boundary(runtime_components, "RuntimeRoot internals") {
  Component(DocumentStoreKernel, "DocumentStoreKernel", "lib/src/store/", "Committed document state, document revisions, resource descriptors, and projection cache.")
  Component(SelectionKernel, "SelectionKernel", "lib/src/selection/", "Runtime selected ids, selectionRevision, normalization, and content-only filtering.")
  Component(SelectionFactsPort, "SelectionFactsPort", "query boundary", "Intent-specific immutable selection facts for interaction and frame capture.")
  Component(EditKernel, "EditKernel", "lib/src/edit/", "Synchronous edit sessions with draft, touched-set, commit, and rollback ownership.")
  Component(InteractionEngine, "InteractionEngine", "lib/src/interaction/", "Pointer sessions, tool state, previews, and terminal edit requests.")
  Component(FrameEngine, "FrameEngine", "lib/src/frame/", "Captured main and overlay frames, paint plans, and repaint buses.")
  Component(SpatialKernel, "SpatialKernel", "lib/src/spatial/", "Hit testing, bounds, and spatial indexes derived from document state.")
  Component(ResourceKernel, "ResourceKernel", "lib/src/resources/", "Resource API, dirty resource ids, public resource visual state, and session invalidation events.")
  Component(SurfaceResourceSession, "SurfaceResourceSession", "lib/src/resources/", "Surface-scoped resolver reference, resolverGeneration, ImageResolveCache, budget, and same-frame suppression.")
  Component(CodecBoundary, "CodecBoundary", "lib/src/codec/", "Schema v1 JSON decode, encode, validation, and diagnostics.")
  Component(DiagnosticsHub, "DiagnosticsHub", "lib/src/diagnostics/", "Structured validation and runtime error projection.")
}
Rel(PublicAPI, RuntimeRoot, "creates and drives")
Rel(RuntimeRoot, DocumentStoreKernel, "coordinates")
Rel(RuntimeRoot, SelectionKernel, "coordinates")
Rel(RuntimeRoot, EditKernel, "coordinates")
Rel(RuntimeRoot, InteractionEngine, "coordinates")
Rel(RuntimeRoot, FrameEngine, "coordinates")
Rel(RuntimeRoot, SpatialKernel, "coordinates")
Rel(RuntimeRoot, ResourceKernel, "coordinates")
Rel(RuntimeRoot, SurfaceResourceSession, "invalidates active session through narrow boundary")
Rel(RuntimeRoot, CodecBoundary, "coordinates")
Rel(RuntimeRoot, DiagnosticsHub, "coordinates")
Rel(EditKernel, DocumentStoreKernel, "allowed")
Rel(EditKernel, SelectionKernel, "allowed through commit/applier boundary")
Rel(EditKernel, DiagnosticsHub, "allowed")
Rel(InteractionEngine, EditKernel, "allowed")
Rel(InteractionEngine, SpatialKernel, "allowed")
Rel(InteractionEngine, SelectionFactsPort, "allowed")
Rel(FrameEngine, DocumentStoreKernel, "allowed")
Rel(FrameEngine, SelectionFactsPort, "allowed")
Rel(SelectionFactsPort, SelectionKernel, "implemented by")
Rel(FrameEngine, SpatialKernel, "allowed")
Rel(FrameEngine, SurfaceResourceSession, "allowed")
Rel(SpatialKernel, DocumentStoreKernel, "allowed through typed spatial delta/read ports")
Rel(CodecBoundary, DocumentStoreKernel, "allowed")
Rel(CodecBoundary, DiagnosticsHub, "allowed")
