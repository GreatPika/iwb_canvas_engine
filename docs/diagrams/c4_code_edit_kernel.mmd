C4Component
title EditKernel code component view

Container(PublicAPI, "Public API facade", "lib/src/api/", "Wrapper exports and edit facade entrypoints.")
Container(ContractsPublic, "Public contracts", "lib/src/contracts/public/", "Stable edit, command, id, event, and error declarations.")
Container(ContractsInternal, "Internal contracts", "lib/src/contracts/internal/", "Commit delivery effects and owner fact seams.")
Container(RuntimeRoot, "RuntimeRoot", "lib/src/runtime/", "Coordinates edit and command entrypoints without exposing internals.")
Container(DocumentStoreKernel, "DocumentStoreKernel", "lib/src/store/", "Committed document tables, document revisions, resource descriptors, and projection cache.")
Container(SelectionKernel, "SelectionKernel", "lib/src/selection/", "Runtime selected ids and selectionRevision.")
Container_Boundary(edit_kernel, "EditKernel (lib/src/edit/)") {
  Component(EditSession, "EditSession", "session owner", "Rejects disposed, nested, async, and stale edit handles; owns sparse callback lifetime.")
  Component(SparseJournal, "Sparse journal", "callback-local sparse state", "Records ordinary public edit mutations from committed store facts without public projection.")
  Component(DraftDocument, "DraftDocument", "materialized fallback", "Rollback-safe working copy created only for readDraftDocument or replacement fallback.")
  Component(TouchedSet, "TouchedSet", "change tracker", "Records exact document, geometry, visual, resource, selection, and replacement touches.")
  Component(CommitCompiler, "CommitCompiler", "commit compiler", "Compiles touched state, preflights invariants, prepares typed effects, and produces a CommitPlan.")
  Component(CommitPlan, "CommitPlan", "commit description", "Immutable commit payload with revisions, cache invalidation, repaint requests, and buffered events.")
  Component(CommitApplier, "CommitApplier", "atomic installer", "Installs prepared sparse/materialized document and prepared selection effects.")
}

Rel(PublicAPI, ContractsPublic, "wrapper exports")
Rel(ContractsInternal, ContractsPublic, "uses public ids")
Rel(PublicAPI, RuntimeRoot, "delegates edit(fn) or command mutation")
Rel(RuntimeRoot, EditSession, "opens synchronous edit session")
Rel(EditSession, DocumentStoreKernel, "reads committed sparse facts")
Rel(EditSession, SparseJournal, "records ordinary mutations")
Rel(SparseJournal, TouchedSet, "records exact sparse invalidation")
Rel(EditSession, DraftDocument, "materializes only on explicit draft read/replacement")
Rel(DraftDocument, TouchedSet, "records fallback mutations")
Rel(EditSession, CommitCompiler, "finalizes synchronous callback")
Rel(TouchedSet, CommitCompiler, "supplies exact invalidation inputs")
Rel(EditSession, DocumentStoreKernel, "prepares sparse commit before swap")
Rel(CommitApplier, SelectionKernel, "prepares accepted selection effects before store install")
Rel(CommitCompiler, CommitPlan, "produces immutable commit plan")
Rel(CommitCompiler, CommitApplier, "hands off preflighted commit work")
Rel(CommitPlan, CommitApplier, "describes install payload")
Rel(CommitApplier, DocumentStoreKernel, "atomically installs prepared sparse/materialized state")
Rel(CommitApplier, SelectionKernel, "installs prepared selection effects after store install")
