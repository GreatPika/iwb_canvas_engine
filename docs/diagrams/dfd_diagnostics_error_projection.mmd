%% Diagnostics and error projection data flow
flowchart LR

  App["Application code"]

  subgraph PublicBoundary["Public API and runtime boundaries"]
    PublicCalls["Public calls\nDTO construction, codec, load, edit, resources"]
    NonHubErrorProjection["Ordinary error projection\nedit/resource/runtime failures\nwithout DiagnosticsHub record"]
    RuntimeFlows["Runtime flows\nplanned hub routes and non-hub probes"]
    PublicException["CanvasDataException\ncode, message, path,\nbounded details"]
    RuntimeSafeError["Runtime-safe error projection\nStateError or CanvasDataException"]
  end

  subgraph ErrorSources["Error sources"]
    CodecValidationErrors["Codec/schema validation errors\nand staged-load codec bridge"]
    OtherValidationErrors["Other validation/runtime errors\nprojected without hub record\nunless table row is added"]
    RuntimeErrors["Planned runtime diagnostics\ninteraction reliability,\ngeometry corruption"]
    ObserverFailures["Planned P14 observer failures\npost-acceptance contained\nno rollback or accepted-result mutation"]
    InternalErrors["Planned/internal diagnostics self-protection\nsanitized fallback path"]
    NonHubProbes["Non-hub probes and counters\nresource/session, eraser,\npure SpatialKernel budgets"]
  end

  subgraph HotSuccess["Successful hot paths with diagnostics disabled"]
    PointerMoveSuccess["Successful pointer move"]
    PaintSuccess["Successful main or overlay paint"]
    DisabledGate["Disabled diagnostic policy\nbranch-only overhead"]
    NoSuccessAllocation["No DiagnosticRecord allocation\nno details string interpolation"]
  end

  subgraph DiagnosticsHub["DiagnosticsHub internal"]
    PolicyGate["Diagnostic policy gate\ndisabled, summary, verbose"]
    VerboseLimitValidation["Verbose policy limit validation\npreview length and list entries"]
    DiagnosticRecord["DiagnosticRecord\ncode, severity, source,\npath, details sanitized map,\nrevision, sessionId, correlationId"]
    RawDetails["Raw error context\nlimits, ids, counts,\nfield values, source error facts"]
    Sanitizer["Diagnostics sanitizer\nJSON-like primitives,\nbounded preview length,\nand bounded entry counts"]
    SanitizedDetails["Sanitized details map\nbounded strings, lists,\nmaps, numbers, booleans\nnot CanvasMetadata"]
    SummaryProjection["Summary projection\nstable code, path, message"]
    VerboseProjection["Verbose projection\ncapped detail previews"]
    FormattingCache["DiagnosticFormattingCache\nverbose diagnostics only"]
    InternalSink["Internal and test-only sink\npolicy-gated"]
  end

  subgraph Forbidden["Forbidden diagnostic payloads and side effects"]
    UnsafePayloads["Forbidden payloads\nruntime objects, handles,\ncanvases, ui.Image, closures,\nfull scene dumps, filesystem paths"]
    PublicStream["No public diagnostics stream\nin v1 API"]
    RuntimeMutation["No diagnostic mutation\nof document, preview, selection,\nresources, caches, or repaint buses"]
    HotPathAllocation["Forbidden successful hot-path allocation\nrecords or formatted detail strings"]
    ProbeRecord["No DiagnosticRecord\nfor non-hub probes"]
    ObserverThrow["No public error throw\nfor contained observer failure"]
  end

  App -->|"calls public API"| PublicCalls
  PublicCalls -->|"codec/schema or staged-load codec-bridge failure"| CodecValidationErrors
  PublicCalls -->|"edit/resource/runtime failure without table row"| OtherValidationErrors
  RuntimeFlows -->|"table-backed planned hub route"| RuntimeErrors
  RuntimeFlows -->|"post-acceptance observer route"| ObserverFailures
  RuntimeFlows -->|"budget/probe path outside hub"| NonHubProbes
  CodecValidationErrors -->|"implemented codec route"| DiagnosticRecord
  OtherValidationErrors -->|"no DiagnosticsHub write"| NonHubErrorProjection
  RuntimeErrors -->|"planned table row error path"| DiagnosticRecord
  ObserverFailures -->|"contained diagnostics row"| DiagnosticRecord
  InternalErrors -->|"planned/internal self-protection path"| DiagnosticRecord
  NonHubProbes -.->|"not DiagnosticsHub writes"| ProbeRecord
  CodecValidationErrors -->|"bounded validation context"| RawDetails
  RuntimeErrors -->|"safe runtime facts only"| RawDetails
  InternalErrors -->|"fallback facts"| RawDetails

  PolicyGate -->|"controls detail level and sinks"| VerboseLimitValidation
  VerboseLimitValidation -->|"validated policy limits"| Sanitizer
  DiagnosticRecord -->|"structured record facts"| Sanitizer
  RawDetails -->|"candidate details"| Sanitizer
  Sanitizer -->|"safe details only"| SanitizedDetails
  Sanitizer -.->|"reject or replace unsafe values"| UnsafePayloads
  SanitizedDetails -->|"summary policy"| SummaryProjection
  SanitizedDetails -->|"verbose policy"| VerboseProjection
  VerboseProjection -->|"formatting allowed only here"| FormattingCache
  SummaryProjection -->|"project public error"| PublicException
  VerboseProjection -->|"project public error with capped details"| PublicException
  SanitizedDetails -.->|"enabled policies only"| InternalSink
  InternalSink -.->|"not exported"| PublicStream

  PublicException -->|"throw to caller\nallocated only on error path"| App
  NonHubErrorProjection -->|"StateError or CanvasDataException"| RuntimeSafeError
  RuntimeErrors -->|"non-data runtime failure"| RuntimeSafeError
  RuntimeSafeError -->|"throw to caller"| App
  ObserverFailures -.->|"must not throw or roll back accepted result"| ObserverThrow

  PointerMoveSuccess --> DisabledGate
  PaintSuccess --> DisabledGate
  DisabledGate -->|"success path"| NoSuccessAllocation
  NoSuccessAllocation -.->|"does not create"| DiagnosticRecord
  NoSuccessAllocation -.->|"blocks"| HotPathAllocation

  DiagnosticRecord -.->|"must not expose"| UnsafePayloads
  SanitizedDetails -.->|"must not contain"| UnsafePayloads
  Sanitizer -.->|"forbidden side effect"| RuntimeMutation
  PublicException -.->|"only public projection"| PublicStream
