%% schema-v1 JSON load success/failure data flow
flowchart LR

  App["Application code"]

  subgraph API["Public API boundary"]
    LoadPort["CanvasEditPort.loadDocumentFromJson(json)"]
    Json["Schema v1 JSON string"]
    Result["Return or exception"]
  end

  subgraph Codec["CodecBoundary"]
    Parse["Raw length, JSON parse,\nschemaVersion, known fields"]
    ImportEvents["Dependency-neutral\nschema-v1 import events"]
    CodecFailure["CanvasDataException\nfrom parse, validation,\nor import-event read"]
  end

  subgraph Store["DocumentStoreKernel"]
    ExistingStore["Existing committed rows,\nrevisions, id admission"]
    PrepareRows["Store-owned preparation\nfamily rows, layer order,\nsealed descriptor rows,\nfinal-candidate relationships, ids, revisions,\ncamera facts"]
    Prepared["PreparedStoreDocumentImport\nconsume-once payload"]
    StoreFailure["CanvasDataException or StateError\nfrom duplicate ids, admission,\ndescriptor relationships, or row preparation"]
    AtomicInstall["Atomic prepared-row install"]
    ReplacementStore["Replacement committed rows\nand id admission"]
  end

  subgraph Interaction["Interaction owners"]
    ExistingInteraction["Active gesture, preview,\npointer normalization,\ntext edit transient state"]
    Cleanup["Success-only prepared\nload cleanup"]
    CleanupOutcome["LoadInteractionCleanupOutcome"]
    CleanupFailure["StateError before install"]
  end

  subgraph Runtime["Runtime accepted result"]
    SelectionClear["Selection clear\nsame runtime result"]
    ViewCamera["Runtime view camera\nfrom persisted JSON camera"]
    Revisions["Document, selection,\nviewCamera, epoch,\noptional preview revisions"]
    Invalidations["Projection, spatial,\nframe, resource invalidations\nwithout building CanvasDocument"]
    Notify["One CanvasRuntimeState\nafter install\nno CanvasActionCommitted"]
  end

  subgraph FailureBoundary["Failure boundary"]
    FailureSnapshot["Existing committed rows,\nselection, camera, preview,\nrevisions, caches, actions,\neffects, and listeners unchanged"]
  end

  App --> LoadPort
  LoadPort --> Json
  Json --> Parse
  Parse --> ImportEvents
  ImportEvents --> PrepareRows
  ExistingStore --> PrepareRows
  PrepareRows --> Prepared
  Prepared --> Cleanup
  ExistingInteraction --> Cleanup
  Cleanup --> CleanupOutcome
  CleanupOutcome --> AtomicInstall
  Prepared --> AtomicInstall
  AtomicInstall --> ReplacementStore
  ReplacementStore --> SelectionClear
  SelectionClear --> ViewCamera
  ViewCamera --> Revisions
  Revisions --> Invalidations
  Invalidations --> Notify
  Notify --> Result
  Result --> App

  Parse -.-> CodecFailure
  ImportEvents -.-> CodecFailure
  PrepareRows -.-> StoreFailure
  Cleanup -.-> CleanupFailure
  CodecFailure -.-> FailureSnapshot
  StoreFailure -.-> FailureSnapshot
  CleanupFailure -.-> FailureSnapshot
  FailureSnapshot -.-> Result
