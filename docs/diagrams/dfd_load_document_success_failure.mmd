%% loadDocument success/failure data flow
flowchart LR

  App["Application code"]

  subgraph API["Public API boundary"]
    LoadPort["CanvasEditPort.loadDocument(document)"]
    PublicDocument["CanvasDocument DTO\nwith CanvasMetadata"]
    Result["Return or projected exception"]
  end

  subgraph Staging["Staged load boundary"]
    Validator["Document validation\npublic DTO invariants\nand frozen metadata"]
    Materializer["PreparedDocumentLoad materialization\nruntime tables and ids"]
    Prepared["Prepared replacement\ncommitted document payload"]
    Failure["Load failure\nCanvasDataException or StateError"]
  end

  subgraph Interaction["InteractionEngine state"]
    ActivePreview["Active gesture and preview"]
    PendingInput["Pointer normalization and pending tap history"]
    Interrupt["Success-only interaction interrupt\nclear active gesture and preview"]
    PostInstallCleanup["Post-install input cleanup\nclear pointer normalization and pending tap history"]
  end

  subgraph Store["DocumentStoreKernel"]
    ExistingCommitted["Existing committed document\nrevisions, projection cache"]
    AtomicInstall["Atomic document install\nreplacement payload boundary"]
    ReplacementCommitted["Replacement committed document"]
  end

  subgraph Selection["SelectionKernel"]
    ExistingSelection["Existing selected ids\nand selectionRevision"]
    SelectionClear["Selection clear effect\nsame runtime result"]
    ReplacementSelection["Replacement selection state\nselected ids cleared"]
  end

  subgraph Effects["Committed effects"]
    AtomicRuntimeResult["Atomic runtime result\ndocument replacement + selection clear"]
    Revisions["Document-level revisions\ncontroller epoch"]
    SpatialRebuild["Spatial index rebuild"]
    ProjectionEvict["Projection cache eviction"]
    ResourceEvict["Resource cache eviction"]
    Repaint["Main and overlay repaint"]
    Notify["Public notify after install\nno user action event"]
    Diagnostics["Diagnostics projection\nvalidation/materialization failures"]
  end

  App -->|"external document replacement request"| LoadPort
  LoadPort -->|"public document input"| PublicDocument
  PublicDocument -->|"validate before runtime side effects"| Validator
  Validator -->|"validated DTO data with CanvasMetadata"| Materializer
  Materializer -->|"prepared runtime document"| Prepared

  Validator -.->|"invalid public document"| Failure
  Materializer -.->|"materialization failure"| Failure
  Failure -.->|"projected failure"| Diagnostics
  Diagnostics -.->|"rethrow projected exception"| Result
  Result -.->|"failure result"| App

  Failure -.->|"no interrupt; preview unchanged"| ActivePreview
  Failure -.->|"pointer normalization and tap history unchanged"| PendingInput
  Failure -.->|"no committed state, revision, cache, repaint, or event change"| ExistingCommitted
  Failure -.->|"selection owner unchanged"| ExistingSelection

  Prepared -->|"success-only interrupt request"| Interrupt
  ActivePreview -->|"clear active gesture state"| Interrupt
  Interrupt -->|"prepared replacement after preview cleanup"| AtomicInstall
  Prepared -->|"document install payload"| AtomicInstall
  Prepared -->|"selection clear effect"| SelectionClear
  AtomicInstall -->|"replace committed state"| ReplacementCommitted
  SelectionClear -->|"clear selected ids and increment selectionRevision"| ReplacementSelection
  ReplacementCommitted -->|"document side installed"| AtomicRuntimeResult
  ReplacementSelection -->|"selection side installed"| AtomicRuntimeResult
  AtomicRuntimeResult -->|"after install only"| PostInstallCleanup
  PendingInput -->|"clear after atomic install"| PostInstallCleanup

  AtomicRuntimeResult -->|"increment document-level revisions, selectionRevision, and epoch"| Revisions
  AtomicRuntimeResult -->|"rebuild from replacement document"| SpatialRebuild
  AtomicRuntimeResult -->|"evict public document projection"| ProjectionEvict
  AtomicRuntimeResult -->|"evict resolver/resource caches"| ResourceEvict
  AtomicRuntimeResult -->|"schedule full document repaint"| Repaint
  AtomicRuntimeResult -->|"publish after atomic install"| Notify
  Notify -->|"success return"| Result
  Result -->|"load completed"| App
