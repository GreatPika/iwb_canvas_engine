%% Overlay frame data flow
flowchart LR

  Surface["CanvasSurface\noverlay paint host"]

  subgraph RuntimeState["Runtime view state"]
    CameraState["Runtime view camera\nviewCameraOffset + viewCameraRevision"]
  end

  subgraph Store["DocumentStoreKernel"]
    ProjectionCache["DocumentProjectionCache\nreadDocument/codec/tests only"]
  end

  subgraph Interaction["InteractionEngine"]
    PreviewSnapshot["PreviewStateSnapshot\npreviewRevision + immutable previewState"]
    SelectedMovePreview["Selected move preview\nmain-scene preview only"]
  end

  subgraph Frame["FrameEngine facade and frame-private collaborators"]
    OverlayRepaint["Overlay repaint request"]
    Capture["FrameCaptureService\noverlay frame capture\nsingle runtime read boundary"]
    CapturedFrame["CapturedOverlayFrame\nviewportRect + effectiveWorldBounds,\npreviewRevision, viewCameraRevision,\nviewCameraOffset, previewState,\nselectionStyle"]
    PreviewAdmission["OverlayPreviewPlanner\npreview admission from captured sealed variant\nexclude CanvasSelectedMovePreview"]
    CapturedOverlayKinds["Captured overlay preview variants\nmarquee, pencil, marker,\npending line start, line preview, eraser"]
    MainRepaintReference["Main repaint bus\noutside overlay paint path"]
    PrimitiveBuilder["OverlayPreviewPlanner\none-shot overlay primitive builder\ncamera-adjusted immutable data"]
    OverlayPrimitives["Immutable overlay primitives\nmarquee fill/stroke, stroke preview,\npending line, eraser corridor,\nselection UI style"]
    ProjectionBlocked["No CanvasDocument materialization\nin overlay paint"]
  end

  subgraph Painter["Painter"]
    OverlayPainter["Overlay painter\ncaptured frame + primitives only"]
    PaintedOverlay["Painted overlay UI"]
    LiveReadBlocked["No live runtime reads\nfrom painter"]
  end

  Surface -->|"paint asks for overlay UI"| OverlayRepaint
  OverlayRepaint -->|"capture once for this paint"| Capture

  Surface -->|"viewportRect,\nselectionStyle"| Capture
  Capture -->|"read view camera once"| CameraState
  CameraState -->|"view camera facts"| Capture
  Capture -->|"read preview state once"| PreviewSnapshot
  PreviewSnapshot -->|"previewRevision and previewState"| Capture
  Capture -->|"compact captured overlay facts\nincluding derived effectiveWorldBounds"| CapturedFrame

  CapturedFrame -->|"captured CanvasPreviewState only"| PreviewAdmission
  PreviewAdmission -->|"admitted overlay variant payloads"| CapturedOverlayKinds
  CapturedOverlayKinds -->|"variant facts"| PrimitiveBuilder
  CapturedFrame -->|"view camera and style facts"| PrimitiveBuilder
  PrimitiveBuilder -->|"build immutable overlay primitives once"| OverlayPrimitives

  PreviewAdmission -.->|"selected move preview is rejected here"| SelectedMovePreview
  SelectedMovePreview -.->|"handled by main scene repaint,\nnot overlay painter"| MainRepaintReference

  OverlayPrimitives -->|"immutable overlay data"| OverlayPainter
  CapturedFrame -->|"captured overlay facts"| OverlayPainter
  OverlayPainter -->|"draw commands"| PaintedOverlay
  PaintedOverlay --> Surface

  OverlayPainter -.->|"forbidden"| LiveReadBlocked
  LiveReadBlocked -.->|"no DocumentStore, InteractionEngine,\nFrameEngine, Public API, or resolver reads"| OverlayPainter
  Capture -.->|"forbidden in paint hot path"| ProjectionBlocked
  ProjectionCache -.->|"not read by overlay paint"| ProjectionBlocked
  Capture -.->|"must not read committed document,\nselection, spatial, background,\nelement row, or resource descriptor facts"| ProjectionBlocked
