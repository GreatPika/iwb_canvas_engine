%% Main paint frame data flow
flowchart LR

  Surface["CanvasSurface\nmain paint host"]
  AppResolver["Application resourceResolver\nsynchronous app-owned image read"]

  subgraph Store["DocumentStoreKernel"]
    Committed["Committed tables\nrevisions, camera, selection,\nresource descriptors"]
    ProjectionCache["DocumentProjectionCache\nreadDocument/codec/tests only"]
  end

  subgraph Interaction["InteractionEngine"]
    PreviewSnapshot["Immutable preview snapshot\nselected move delta if active"]
  end

  subgraph Spatial["SpatialKernel"]
    PaintIndex["Paint spatial index\ncandidate ids and generations"]
    ShiftedCandidates["Selected supplement candidates\nquery shifted by -previewDelta"]
  end

  subgraph Resources["ResourceKernel"]
    ResolvePaintAsset["Resolve paint asset\nResourceKernel-owned resolver boundary"]
    ImageResolveCache["ImageResolveCache\nresourceId + resourceRevision"]
    ResolverFrameBudget["Resolver frame budget\nkMaxSyncResourceResolverCallsPerFrame = 128"]
    BudgetPlaceholder["Budget-exceeded placeholder\nnot cached as null/missing"]
    MissingPlaceholder["Bounded missing image placeholder"]
  end

  subgraph Frame["FrameEngine"]
    RepaintSignal["Main repaint request"]
    Capture["Main frame capture\nsingle runtime read boundary"]
    CapturedFrame["CapturedMainFrame\ndocument, structural, bounds,\nelementVisual, frameMeta, selection,\nresourceVisual, camera, viewport,\nselectedMoveDelta"]
    PaintPlanCache["PaintPlanCache\nordinary committed records only\nno frameMeta, selectedMoveDelta,\nor previewDelta in key/value"]
    OrdinaryPlan["Ordinary committed paint plan\ncached RenderElementRecord list"]
    OrdinaryStage["Ordinary paint candidates\nviewport and halo"]
    SupplementStage["Per-frame selected supplement staging\npreview-shifted visibility"]
    RecordBuilder["Render record builder\nresolve handles by revision/generation"]
    FilterOrdinary["Filter selected movable ids\nfrom ordinary stream for this frame"]
    Merge["Order-token merge\nno full-scene sort"]
    Records["Immutable RenderElementRecord list\ncompact row views, selection flags,\npreviewDelta"]
    DescriptorSnapshots["Descriptor snapshots\nresourceId + appKey descriptor + resourceRevision"]
    RenderCaches["Frame render caches\ntext, path, stroke"]
    StaticBackgroundCache["StaticBackgroundCache\nbackground + grid + camera bucket + dpr"]
    ResolvedAssets["Resolved paint assets\nimages or placeholders"]
    PaintAlphaPolicy["Ordinary opacity policy\nelement/stroke opacity -> primitive paint alpha\nno implicit saveLayer"]
    ExplicitLayerEffect["Future saveLayer effect\nexplicit RenderElementRecord field,\nbudgeted, metric-counted,\nand guarded by contract update"]
    ProjectionBlocked["No CanvasDocument materialization\nin main paint"]
  end

  subgraph Painter["Painter"]
    MainPainter["Main painter\nrecords + render caches + assets only"]
    PaintedScene["Painted main scene"]
    LiveReadBlocked["No live runtime reads\nfrom painter"]
  end

  Surface -->|"paint asks for main scene"| RepaintSignal
  RepaintSignal -->|"capture once for this paint"| Capture

  Capture -->|"read committed frame facts once"| Committed
  Committed -->|"revisioned table snapshot facts"| CapturedFrame
  Capture -->|"read immutable selected move preview once"| PreviewSnapshot
  PreviewSnapshot -->|"selectedMoveDelta or none"| CapturedFrame

  CapturedFrame -->|"ordinary cache key\nstructural, bounds, elementVisual,\nviewport, selection"| PaintPlanCache
  PaintPlanCache -->|"cache hit: ordinary committed records"| OrdinaryPlan
  PaintPlanCache -->|"cache miss inputs"| OrdinaryStage

  OrdinaryStage -->|"viewport query only"| PaintIndex
  PaintIndex -->|"candidate ids with generations"| OrdinaryStage

  OrdinaryStage -->|"ordinary handles"| RecordBuilder
  RecordBuilder -->|"resolve row data by captured revisions"| Committed
  Committed -->|"immutable row views\nstale generation rejected"| RecordBuilder
  RecordBuilder -->|"ordinary committed records"| OrdinaryPlan
  OrdinaryPlan -->|"store ordinary records only"| PaintPlanCache

  OrdinaryPlan -->|"ordinary stream"| FilterOrdinary
  CapturedFrame -->|"selection ids and preview delta"| FilterOrdinary
  CapturedFrame -->|"selectedMoveDelta for this frame"| SupplementStage
  SupplementStage -->|"shifted visibility query only"| ShiftedCandidates
  ShiftedCandidates -->|"selected candidate ids with generations"| SupplementStage
  SupplementStage -->|"shifted selected handles"| RecordBuilder
  RecordBuilder -->|"per-frame supplement records\nwith previewDelta"| Merge
  FilterOrdinary -->|"ordinary records excluding\nmoved selected ids"| Merge
  Merge -->|"ordered frame records\nnot stored in PaintPlanCache"| Records

  Records -->|"text/path/stroke keys"| RenderCaches
  CapturedFrame -->|"background/grid/camera bucket/dpr"| StaticBackgroundCache
  Records -->|"ordinary opacity render input"| PaintAlphaPolicy
  PaintAlphaPolicy -->|"primitive paint alpha only"| MainPainter
  ExplicitLayerEffect -.->|"required before any saveLayer-producing effect\nframe.paint_candidates offscreen-layer metric"| MainPainter
  RenderCaches -->|"bounded cached paint primitives"| MainPainter
  StaticBackgroundCache -->|"bounded static background primitive"| MainPainter

  Records -->|"image resource ids"| DescriptorSnapshots
  DescriptorSnapshots -->|"read committed descriptor facts\nby captured revision"| Committed
  Committed -->|"immutable descriptor snapshots"| DescriptorSnapshots
  DescriptorSnapshots -->|"descriptor snapshot + resourceRevision"| ResolvePaintAsset
  ResolvePaintAsset -->|"cache lookup and bounded update"| ImageResolveCache
  ImageResolveCache -->|"cached image, null,\nor missing result"| ResolvePaintAsset
  ImageResolveCache -->|"cache miss"| ResolverFrameBudget
  ResolverFrameBudget -->|"budget available\nsync read request"| AppResolver
  ResolverFrameBudget -.->|"budget exceeded\nResourceKernel-owned probe + at most one pending\nthrottled follow-up repaint"| BudgetPlaceholder
  BudgetPlaceholder -.->|"bounded placeholder\nno cache write"| ResolvedAssets
  AppResolver -->|"app-owned image reference\nno engine IO, no mutation"| ResolvePaintAsset
  ResolvePaintAsset -->|"resolved image"| ResolvedAssets
  ResolvePaintAsset -.->|"missing or unresolved"| MissingPlaceholder
  MissingPlaceholder -.->|"bounded placeholder asset"| ResolvedAssets

  Records -->|"immutable render records"| MainPainter
  ResolvedAssets -->|"paint-time assets"| MainPainter
  MainPainter -->|"draw commands"| PaintedScene
  PaintedScene --> Surface

  MainPainter -.->|"forbidden"| LiveReadBlocked
  MainPainter -.->|"forbidden ordinary opacity path"| ExplicitLayerEffect
  LiveReadBlocked -.->|"no DocumentStore, SpatialKernel,\nInteractionEngine, or Public API reads"| MainPainter
  Capture -.->|"forbidden in paint hot path"| ProjectionBlocked
  ProjectionCache -.->|"not read by main paint"| ProjectionBlocked
