%% Main paint frame data flow
flowchart LR

  Surface["CanvasSurface\nresource-free main paint host"]
  ExplicitSessionCaller["Frame/internal caller\nexplicit SurfaceResourceSession"]
  AppResolver["Application resourceResolver\nsynchronous app-owned resource-asset read"]

  subgraph Store["DocumentStoreKernel"]
    Committed["Committed tables\ndocument revisions,\nresource descriptors"]
    ProjectionCache["DocumentProjectionCache\nreadDocument/codec/tests only"]
  end

  subgraph FrameFactsPort["contracts/internal FrameFactsPort"]
    CommittedFrameFacts["Committed frame facts\ndocument/structural/bounds/\nelementVisual/background/grid revisions"]
    RowSnapshots["Committed row snapshots\nstale structuralRevision/generation/orderToken rejected"]
    DescriptorFacts["Descriptor facts\nresourceId + sealed image/vector appKey descriptor + resourceRevision"]
  end

  subgraph RuntimeState["Runtime view state"]
    ViewCamera["Runtime view camera\nviewCameraOffset + viewCameraRevision"]
  end

  subgraph ResourceRuntime["ResourceKernel"]
    ResourceVisualRevision["resourceVisualRevision"]
  end

  subgraph Selection["SelectionKernel"]
    SelectionFacts["Captured selection facts\nselected ids and selectionRevision"]
  end

  subgraph Interaction["InteractionEngine"]
    PreviewSnapshot["CanvasSelectedMovePreview snapshot\ndelta if active"]
  end

  subgraph Spatial["SpatialKernel"]
    PaintIndex["Paint spatial index\ncandidate ids, generations,\nand order tokens"]
    ShiftedCandidates["Selected supplement candidates\nquery shifted by -previewDelta\nwith order tokens"]
  end

  subgraph Resources["lib/src/resources SurfaceResourceSession"]
    ResolvePaintAsset["Resolve paint asset\nsession resolver boundary"]
    ResourceAssetCache["ResourceAssetCache\nresolverGeneration + resourceId + resourceRevision"]
    ResolverFrameBudget["Resolver frame budget\nfixed per-frame guard"]
    BudgetPlaceholder["Budget-exceeded placeholder\nnot cached as null/missing"]
    MissingPlaceholder["Bounded missing resource placeholder"]
  end

  subgraph Frame["FrameEngine facade and frame-private collaborators"]
    RepaintSignal["Main repaint request"]
    Capture["FrameCaptureService\nmain frame capture\nsingle runtime read boundary"]
    CapturedFrame["CapturedMainFrame\ndocument, structural, bounds,\nelementVisual, backgroundRevision,\ngridRevision, gridStrokeWidth,\nresourceVisual, selection,\nselectionStyle,\nview camera, viewportRect,\ndevicePixelRatio, selectedMoveDelta"]
    OrdinaryPaintRecordCache["OrdinaryPaintRecordCache\nordinary committed records only\nno background/grid, view camera,\nselectedMoveDelta, previewDelta,\nor style-only facts in key/value"]
    OrdinaryPlan["Ordinary committed paint plan\nper-frame admitted record stream"]
    OrdinaryStage["OrdinaryPaintPlanner\nordinary paint candidates\neffective world viewport"]
    SupplementStage["SelectedMoveSupplementPlanner\nper-frame selected supplement staging\npreview-shifted visibility"]
    OrdinaryRecordBuilder["OrdinaryPaintPlanner\nordinary record builder\nresolve handles by revision/generation/orderToken"]
    SupplementRecordBuilder["SelectedMoveSupplementPlanner\nsupplement record builder\nresolve shifted handles by revision/generation/orderToken"]
    FilterOrdinary["SelectedMoveSupplementPlanner\nfilter selected movable ids\nfrom ordinary stream for this frame"]
    Merge["Order-token merge\nno full-scene sort"]
    SelectionDecoration["SelectionDecorationPlanner\nselection decoration plan\nsealed-row chrome placement,\nhidden during selected move preview"]
    Records["Immutable frame output\nsealed row payload variants,\nselected move supplements,\nand topmost selection chrome"]
    RenderCaches["Frame render caches\ntext, path, stroke"]
    StaticBackgroundCache["StaticBackgroundPlanner\nStaticBackgroundCache\nbackgroundRevision + gridRevision\n+ gridStrokeWidth + view camera bucket\n+ viewportRect + devicePixelRatio"]
    AssetBinding["PaintAssetBindingService\ndescriptor-to-asset binding\nthrough SurfaceResourceSession"]
    ResolvedAssets["Resolved paint assets\ntyped assets or placeholders"]
    PaintAlphaPolicy["Ordinary opacity policy\nelement/stroke opacity -> primitive paint alpha\nno implicit saveLayer"]
    ExplicitLayerEffect["Vector opacity effect\nrecord-local zero-or-one target-bounded layer\npartial opacity only"]
    ProjectionBlocked["No CanvasDocument materialization\nin main paint"]
  end

  subgraph Painter["Painter"]
    MainPainter["Main painter\nrecords + render caches + assets only"]
    PaintedScene["Painted main scene"]
    LiveReadBlocked["No live runtime reads\nfrom painter"]
  end

  Surface -->|"paint asks for resource-free main scene"| RepaintSignal
  Surface -->|"selectionStyle paint input"| Capture
  RepaintSignal -->|"capture once for this paint"| Capture

  Capture -->|"request committed frame facts once"| CommittedFrameFacts
  CommittedFrameFacts -->|"read revision facts"| Committed
  Committed -->|"revisioned table snapshot facts"| CommittedFrameFacts
  CommittedFrameFacts -->|"immutable committed facts"| CapturedFrame
  Capture -->|"read runtime view camera once"| ViewCamera
  ViewCamera -->|"viewCameraRevision and viewCameraOffset"| CapturedFrame
  Capture -->|"read resource visual facts once"| ResourceVisualRevision
  ResourceVisualRevision -->|"resourceVisualRevision"| CapturedFrame
  Capture -->|"read selected ids once"| SelectionFacts
  SelectionFacts -->|"selectionRevision and selected ids"| CapturedFrame
  Capture -->|"read CanvasSelectedMovePreview once"| PreviewSnapshot
  PreviewSnapshot -->|"delta or none"| CapturedFrame

  CapturedFrame -->|"ordinary cache key\nstructural, bounds, elementVisual,\nviewportRect, devicePixelRatio"| OrdinaryPaintRecordCache
  OrdinaryPaintRecordCache -->|"cache hit: admitted committed record"| OrdinaryPlan
  OrdinaryPaintRecordCache -->|"cache miss inputs"| OrdinaryStage

  OrdinaryStage -->|"viewport query only"| PaintIndex
  PaintIndex -->|"candidate ids with generations and order tokens"| OrdinaryStage

  OrdinaryStage -->|"ordinary handles"| OrdinaryRecordBuilder
  OrdinaryRecordBuilder -->|"request row facts by captured revisions"| RowSnapshots
  RowSnapshots -->|"read committed row snapshots"| Committed
  Committed -->|"immutable row views\nstale revision/generation/orderToken rejected"| RowSnapshots
  RowSnapshots -->|"ordinary row facts or stale rejection"| OrdinaryRecordBuilder
  OrdinaryRecordBuilder -->|"ordinary committed records"| OrdinaryPlan
  OrdinaryPlan -->|"store ordinary records only"| OrdinaryPaintRecordCache

  OrdinaryPlan -->|"ordinary stream"| FilterOrdinary
  CapturedFrame -->|"selection ids and preview delta"| FilterOrdinary
  CapturedFrame -->|"selection ids, selectionRevision,\nboundsRevision, selectionStyle,\ndevicePixelRatio, and selected-move active flag"| SelectionDecoration
  CapturedFrame -->|"selectedMoveDelta for this frame"| SupplementStage
  SupplementStage -->|"shifted visibility query only"| ShiftedCandidates
  ShiftedCandidates -->|"selected candidate ids with generations and order tokens"| SupplementStage
  SupplementStage -->|"shifted selected handles"| SupplementRecordBuilder
  SupplementRecordBuilder -->|"request selected row facts\nby captured revisions"| RowSnapshots
  RowSnapshots -->|"selected row facts or stale rejection"| SupplementRecordBuilder
  SupplementRecordBuilder -->|"per-frame supplement records\nwith previewDelta"| Merge
  FilterOrdinary -->|"ordinary records excluding\nmoved selected ids"| Merge
  Merge -->|"ordered ordinary and supplement records\nnot stored in OrdinaryPaintRecordCache"| Records
  SelectionDecoration -->|"topmost selection UI primitives"| Records

  Records -->|"text/path/stroke keys"| RenderCaches
  CapturedFrame -->|"backgroundRevision, gridRevision, gridStrokeWidth,\nviewCameraBucket, viewportRect, devicePixelRatio"| StaticBackgroundCache
  Records -->|"ordinary opacity render input"| PaintAlphaPolicy
  PaintAlphaPolicy -->|"primitive paint alpha only"| MainPainter
  ExplicitLayerEffect -.->|"partial-opacity vector: one bounded layer\nzero/full: no layer"| MainPainter
  RenderCaches -->|"bounded cached paint primitives"| MainPainter
  StaticBackgroundCache -->|"bounded static background primitive"| MainPainter

  Records -->|"resource ids"| AssetBinding
  AssetBinding -->|"request descriptor facts"| DescriptorFacts
  DescriptorFacts -->|"read committed descriptor facts\nby captured revision"| Committed
  Committed -->|"sealed immutable image/vector descriptor facts"| DescriptorFacts
  ExplicitSessionCaller -->|"passes SurfaceResourceSession\nwith resolverGeneration"| AssetBinding
  DescriptorFacts -->|"descriptor snapshot + resourceRevision"| AssetBinding
  AssetBinding -->|"resolve via session only"| ResolvePaintAsset
  ResolvePaintAsset -->|"cache lookup and bounded update"| ResourceAssetCache
  ResourceAssetCache -->|"cached app-owned asset"| ResolvePaintAsset
  ResourceAssetCache -->|"cache miss"| ResolverFrameBudget
  ResolverFrameBudget -->|"budget available\nsync read request"| AppResolver
  ResolverFrameBudget -.->|"budget exceeded\nnon-hub session probe + at most one pending\nthrottled follow-up repaint"| BudgetPlaceholder
  BudgetPlaceholder -.->|"bounded placeholder\nno cache write"| ResolvedAssets
  AppResolver -->|"app-owned resource-asset reference\nno engine IO, no mutation"| ResolvePaintAsset
  ResolvePaintAsset -->|"resolved asset"| ResolvedAssets
  ResolvePaintAsset -.->|"missing or unresolved"| MissingPlaceholder
  MissingPlaceholder -.->|"bounded placeholder asset"| ResolvedAssets

  Records -->|"immutable render records"| MainPainter
  ResolvedAssets -->|"paint-time assets"| MainPainter
  MainPainter -->|"draw commands"| PaintedScene
  PaintedScene --> Surface

  MainPainter -.->|"forbidden"| LiveReadBlocked
  MainPainter -.->|"forbidden ordinary opacity path"| ExplicitLayerEffect
  LiveReadBlocked -.->|"no DocumentStore, SpatialKernel,\nInteractionEngine, or Public API facade reads"| MainPainter
  Capture -.->|"forbidden in paint hot path"| ProjectionBlocked
  ProjectionCache -.->|"not read by main paint"| ProjectionBlocked
