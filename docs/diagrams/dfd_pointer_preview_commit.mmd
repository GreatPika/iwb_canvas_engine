%% Pointer preview and terminal commit/cancel data flow
flowchart LR

  Surface["CanvasSurface\nFlutter pointer host"]

  subgraph SurfacePointerAdapter["Surface pointer adapter boundary"]
    PointerAdapter["CanvasSurfacePointerAdapter\nfinite sample routing;\nterminal cleanup input for invalid up/cancel"]
    InvalidDownMoveEvent["Invalid down/move Flutter pointer facts\nrejected before runtime"]
  end

  subgraph API["Public API boundary"]
    PointerInput["CanvasPointerInput\nfinite samples or no-position\nterminal cleanup input"]
    Sample["CanvasPointerSample\nfinite coordinates for all phases"]
    TerminalCleanupInput["CanvasPointerTerminalCleanup\nno coordinates; up/cancel only"]
    MoveResolver["CanvasMoveCommitResolver\nselected move terminal only"]
    PublicSignals["Public state/effects\naction events, CanvasRuntimeState,\nmain/overlay repaint requests"]
  end

  subgraph Interaction["InteractionEngine"]
    TokenGate["Pointer session gate\none active token per runtime"]
    StaleSample["Stale token sample\nignored"]
    TerminalCleanup["Typed cleanup request\nreason plus ownership context"]
    CleanupCoordinator["PointerToolCleanupCoordinator\ncoordinator-owned cleanup policy"]
    CleanupOutcome["PointerCleanupOutcome\nprevious preview kind,\nstate need, repaint target"]
    PreviewState["Sealed CanvasPreviewState\nvariant snapshot\npreviewRevision"]
    OverlayPreview["Overlay preview variants\nCanvasMarqueePreview,\nCanvasStrokePreview subclasses,\nCanvasPendingLineStartPreview,\nCanvasLinePreview, CanvasEraserPreview"]
    SelectedMovePreview["CanvasSelectedMovePreview\nmain-scene preview delta"]
    SessionPreview["Session-only preview update\ndraw, line, selected move delta"]
    SpatialQuery["Hit-test and candidate queries"]
    CandidatePreview["Candidate-based preview update\nmarquee, eraser, initial hit"]
    CommitIntent["Terminal commit intent\nselection, stroke, line,\neraser, or selected move"]
    CancelIntent["Cancel intent\ncancel, mode change, dispose,\nresolver cancel, zero move"]
    CleanupByKind["Cleanup by active preview kind"]
  end

  subgraph Runtime["RuntimeRoot"]
    Delivery["Interaction commit delivery\nnon-mutating Store candidate read and action descriptor staging"]
    EditResult["Terminal edit result\nruntime-owned delivery outcome"]
    ClosedDeliveryCleanup["Closed-result cleanup\npublish false and effect augmentation"]
  end

  subgraph Spatial["SpatialKernel"]
    Candidates["Geometry policy candidates\nhit/select: visible selectable;\neraser: deletable non-background"]
  end

  subgraph EditKernel["EditKernel"]
    InteractionEdit["Runtime-prepared edit bridge\nsynchronous edit session"]
    Draft["DraftDocument\nrollback-safe mutations"]
    Touched["TouchedSet\nexact changed state"]
    Compiler["CommitCompiler\npreflight and commit plan"]
    Rollback["Rollback discard\nno committed effects"]
  end

  subgraph Store["DocumentStoreKernel"]
    Committed["Committed document\ndocument revisions, resources"]
    AtomicInstall["Atomic install"]
  end

  subgraph Selection["SelectionKernel"]
    SelectionFacts["Selection facts\nselected ids and selectionRevision"]
    SelectionEffect["Selection effect\nset/prune/clear"]
  end

  subgraph Effects["Committed effects"]
    SpatialDelta["Spatial updates\nfor touched ids"]
    MainRepaint["Main repaint bus"]
    OverlayRepaint["Overlay repaint bus\npreview cleanup"]
    Actions["Typed user action events\nonly when terminal commit changes state"]
    ErrorProjection["Error projection\nterminal/edit failures\nno implemented edit-owned DiagnosticsHub writer"]
  end

  Surface -->|"raw Flutter pointer event"| PointerAdapter
  PointerAdapter -->|"finite down/move/up/cancel sample"| Sample
  PointerAdapter -->|"non-finite up/cancel cleanup input"| TerminalCleanupInput
  PointerAdapter -.->|"non-finite or invalid down/move facts"| InvalidDownMoveEvent
  InvalidDownMoveEvent -.->|"no runtime route, preview, repaint, edit, or event"| Surface
  Sample --> PointerInput
  TerminalCleanupInput --> PointerInput
  PointerInput -->|"finite sample or cleanup-only terminal input"| TokenGate
  TokenGate -.->|"stale non-terminal token"| StaleSample
  StaleSample -.->|"no preview, repaint, edit, or event"| Surface
  TokenGate -.->|"stale terminal or terminal cleanup input\ncleanup only, no commit intent"| TerminalCleanup

  TokenGate -->|"valid down/move sample\nfor draw/line/visual eraser/move delta"| SessionPreview
  TokenGate -->|"valid sample needing candidates\nhit policy, marquee, terminal eraser"| SpatialQuery
  SpatialQuery -->|"read-only candidate lookup"| Candidates
  SpatialQuery -->|"batched intent-specific selection facts"| SelectionFacts
  Candidates -->|"hit-test, selection, or eraser candidate facts"| SpatialQuery

  SessionPreview -->|"variant payload facts; no public pointer/session ids"| PreviewState
  SpatialQuery -->|"candidate facts"| CandidatePreview
  CandidatePreview -->|"variant payload facts"| PreviewState
  PreviewState -->|"sealed overlay preview snapshot"| OverlayPreview
  PreviewState -->|"delta-only selected move snapshot"| SelectedMovePreview
  PreviewState -->|"publish CanvasRuntimeState with state.revisions.preview when changed"| PublicSignals
  OverlayPreview -->|"previewRevision + overlay repaint only"| OverlayRepaint
  SelectedMovePreview -->|"previewRevision + main repaint only"| MainRepaint

  TokenGate -->|"terminal same-token up"| CommitIntent
  TokenGate -->|"cancel terminal or external cancellation"| CancelIntent
  CancelIntent -->|"discard preview without document mutation"| TerminalCleanup
  TerminalCleanup -->|"InteractionEngine only caller"| CleanupCoordinator
  CleanupCoordinator -->|"effect-only outcome"| CleanupOutcome
  CleanupOutcome -->|"CanvasNoPreview\npreviewRevision if active"| PreviewState
  CleanupOutcome -->|"previous active preview kind"| CleanupByKind
  CleanupByKind -->|"selected move cleanup"| MainRepaint
  CleanupByKind -->|"overlay preview cleanup"| OverlayRepaint

  CommitIntent -->|"selected move zero delta or empty movable set\nbefore resolver"| CancelIntent
  CommitIntent -->|"selected move request when non-zero\nand movable set is non-empty"| MoveResolver
  MoveResolver -.->|"CanvasMoveCancel"| CancelIntent
  MoveResolver -.->|"resolver exception requires preview cleanup"| TerminalCleanup
  MoveResolver -.->|"runtime-safe error"| ErrorProjection
  MoveResolver -->|"finite committed delta"| CommitIntent

  CommitIntent -->|"terminal commit intent\nno document mutation yet"| Delivery
  Delivery -->|"read-only candidate, public element,\nand action descriptor"| InteractionEdit
  InteractionEdit -->|"draft mutations for terminal result"| Draft
  Draft -->|"exact touched state"| Touched
  Touched -->|"compile exact effects"| Compiler
  Compiler -->|"preflighted commit payload"| AtomicInstall
  AtomicInstall -->|"accepted ledger reserves route ID, replaces committed tables, and invalidates projection revision"| Committed
  AtomicInstall -->|"apply selection effects atomically"| SelectionEffect
  SelectionEffect -->|"update selected ids/revision"| SelectionFacts

  AtomicInstall -->|"commit result"| EditResult
  EditResult -->|"EditKernel closes handle, then RuntimeRoot performs publish-false cleanup"| ClosedDeliveryCleanup
  ClosedDeliveryCleanup -->|"cleanup outcome augments repaint, then guarded common delivery: spatial scope"| SpatialDelta
  SpatialDelta -->|"then resource/release and root/bridge frame repaint"| MainRepaint
  MainRepaint -->|"then state, changed action, non-empty observer"| Actions

  InteractionEdit -.->|"edit exception, rejected Future,\nor preflight failure"| Rollback
  Rollback -.->|"candidate remains next; committed document, selection, revisions,\nand action events unchanged"| ErrorProjection
  ErrorProjection -.->|"projected runtime-safe error"| Surface
  PublicSignals --> Surface
  MainRepaint --> PublicSignals
  OverlayRepaint --> PublicSignals
  Actions --> PublicSignals
