%% Cache invalidation data flow
flowchart LR

  App["Application"]
  Surface["CanvasSurface\nactive surface listener"]

  subgraph Sources["Invalidation sources"]
    Touched["TouchedSet\nadded/removed/updated/transformed ids,\ngeometry/element visual changed ids,\nresource descriptor/visual ids,\nlayer order, background layer,\nselection, persisted camera, background, grid,\npalette, documentReplaced"]
    LoadSuccess["Staged load success\ntyped replacement effect"]
    PreviewCleanup["Preview cleanup\nterminal or cancel repaint effect"]
    EmptyOrRollback["Empty touched set or rollback\nno revisions, cache eviction,\nspatial change, repaint, or events"]
    ResourceDirtyCall["contracts/public CanvasResourcePort\nmarkResourceDirty / markAllResourcesDirty"]
    ViewCameraCall["CanvasCameraPort\nsetOffset / panBy"]
    InteractionConfigCall["CanvasInteractionPort\nsetMode / setDrawStyle / setDrawTool /\nsetDrawColor / setPointerPolicy"]
  end

  subgraph Runtime["RuntimeRoot"]
    ResourceDirtyDispatch["Resource dirty orchestration\nrevision increment + cache eviction"]
    ViewCameraDispatch["Runtime view camera orchestration\nstate.revisions.viewCamera + repaint"]
    InteractionConfigDispatch["Interaction config orchestration\nstate.revisions.interaction + affected cleanup"]
    RuntimeRepaintEffects["RepaintDeliveryEffect and cleanup repaint targets\nruntime-owned main/overlay flags"]
    SurfaceTargetAggregation["Runtime/effect repaint target aggregation\npre-output surface invalidation"]
    DeferredSpatialRepair["Deferred invalid-index repair\nrebuild or retry outside hot pointer/paint path"]
  end

  subgraph Compiler["Commit compiler"]
    ExactPlan["CommitPlan\nexact revisions and invalidation scopes"]
    OrdinaryScope["Ordinary edit scope\ntouched ids and typed state only"]
    ReplacementScope["Edit documentReplaced scope\nonly CommitPlan full rebuild"]
    EmptySpatialReset["Operation-matrix clearContent\nempty spatial reset only"]
    ForbiddenGlobal["Forbidden generic global invalidation\nunless documentReplaced"]
  end

  subgraph Store["DocumentStoreKernel"]
    CommittedInstall["Atomic committed install"]
    TypedRevisionScope["Typed revision scope\noperation matrix decides changed counters"]
    RevisionState["RevisionState"]
    DocumentRevision["documentRevision"]
    StructuralRevision["structuralRevision"]
    BoundsRevision["boundsRevision"]
    ElementVisualRevision["elementVisualRevision"]
    BackgroundRevision["backgroundRevision"]
    GridRevision["gridRevision"]
    ProjectionRevision["projectionRevision"]
    ResourceRevision["resourceRevision"]
  end

  subgraph PublicState["Public CanvasRuntimeState"]
    RuntimeStateRevision["state.revisions\npublic domains"]
    DocumentPublicRevision["document"]
    SelectionPublicRevision["selection"]
    PreviewRevision["preview"]
    ViewCameraRevision["viewCamera"]
    ResourceVisualPublicRevision["resourceVisual"]
    InteractionPublicRevision["interaction"]
    EpochPublicRevision["epoch"]
  end

  subgraph SurfaceBridge["Runtime-surface bridge"]
    SurfaceFrame["CanvasRuntimeSurfaceFrame\ncurrent state + generation"]
    SurfaceTarget["CanvasSurfaceRepaintTarget\nmainCanvas / overlayCanvas / reason"]
    FrameSignalBoundary["FrameRepaintSignal\noutput metadata only,\nnot pre-output scheduling"]
  end

  subgraph Selection["SelectionKernel"]
    SelectionEffect["Selection effect\nset, prune, clear, normalize"]
    SelectionRevision["selectionRevision"]
  end

  subgraph Spatial["SpatialKernel"]
    SpatialIndex["SpatialIndex\nentries by touched id"]
    SpatialDelta["SpatialDelta\nadd, remove, touched update"]
    TouchedSpatialUpdate["Ordinary spatial update\nonly touched ids"]
    SpatialRebuild["Spatial rebuild/reset\nreplacement/load or clearContent empty reset only"]
    SpatialFallback["Invalid index fallback\nbudgeted query/candidates,\nnon-hub budget counter,\ndeferred rebuild"]
    SpatialBudgetExceeded["Fallback budget exceeded\ntyped result, no partial candidates"]
  end

  subgraph Projection["Document projection cache"]
    ProjectionEvict["Projection cache eviction\nby projectionRevision scope"]
    NoProjectionHotPath["No CanvasDocument projection\nin paint, pointer, or hit hot paths"]
  end

  subgraph ResourceRuntime["RuntimeRoot / contract-owned dirty outcome"]
    ResourceVisualRevision["resourceVisualRevision"]
    ResourceSessionInvalidation["Active session invalidation event\ndescriptor changed or dirty target/all"]
  end

  subgraph Session["lib/src/resources SurfaceResourceSession"]
    DescriptorCacheEvict["ImageResolveCache eviction\nresource descriptor changed"]
    DirtyResourceEvict["ImageResolveCache eviction\nexplicit dirty target or all"]
  end

  subgraph Frame["FrameEngine facade and frame-private collaborators"]
    PaintPlanInvalidation["OrdinaryPaintPlanner\nOrdinaryPaintRecordCache invalidation\nstructural, bounds, elementVisual,\nviewportRect, devicePixelRatio"]
    SelectionDecorationInvalidation["SelectionDecorationPlanner\nselection decoration invalidation\nselection, structure, bounds, style, DPR"]
    StaticFrameInvalidation["StaticBackgroundPlanner\nStaticBackgroundCache invalidation\nview camera bucket, background, grid"]
    TextPathInvalidation["Text, path, stroke cache invalidation\nonly changed render inputs"]
    MainRepaint["Main repaint bus"]
    OverlayRepaint["Overlay repaint bus\npreview cleanup, load success, view camera"]
    PreviewSnapshot["PreviewStateSnapshot\npreviewRevision"]
  end

  subgraph SurfaceCache["CanvasSurface transient output cache"]
    OutputCache["SurfaceFrameOutputCache\npre-output layer routing"]
    MainOutputNotifier["Main layer output notifier"]
    OverlayOutputNotifier["Overlay layer output notifier"]
    MainPaintHost["Main RepaintBoundary + CustomPaint"]
    OverlayPaintHost["Overlay RepaintBoundary + CustomPaint"]
  end

  subgraph Forbidden["Forbidden effects"]
    DirtyDocumentRevision["Resource dirty must not increment\ndocumentRevision"]
    DirtySelectionPreview["Resource dirty must not clear\nselection or preview"]
    DirtyActionEvent["Resource dirty must not emit\naction events"]
    SpatialFullClone["Full spatial clone\nfor ordinary edit"]
  end

  App -->|"committed edit or terminal commit"| Touched
  App -->|"interaction config change"| InteractionConfigCall
  Touched -->|"no changed facts"| EmptyOrRollback
  EmptyOrRollback -.->|"return without side effects"| App
  Touched -->|"non-empty exact facts"| ExactPlan

  ExactPlan -->|"ordinary edit, no documentReplaced"| OrdinaryScope
  ExactPlan -->|"typed repaint effects"| RuntimeRepaintEffects
  ExactPlan -->|"documentReplaced"| ReplacementScope
  ExactPlan -.->|"not allowed"| ForbiddenGlobal
  ForbiddenGlobal -.->|"blocked unless replacement scope"| ExactPlan

  OrdinaryScope -->|"preflight and commit payload"| CommittedInstall
  OrdinaryScope -->|"operation-matrix clearContent"| EmptySpatialReset
  ReplacementScope -->|"prepared document replacement"| CommittedInstall
  LoadSuccess -->|"prepared staged replacement\noutside edit CommitPlan"| CommittedInstall
  OrdinaryScope -->|"selection effect if operation changes selection"| SelectionEffect
  ReplacementScope -->|"selection clear effect"| SelectionEffect
  LoadSuccess -->|"selection clear effect"| SelectionEffect
  CommittedInstall -->|"publish typed committed revision changes"| TypedRevisionScope
  TypedRevisionScope -->|"update only counters touched by operation"| RevisionState

  RevisionState -.->|"document state changes"| DocumentRevision
  DocumentRevision -->|"public document domain"| DocumentPublicRevision
  DocumentPublicRevision -->|"public runtime state domain"| RuntimeStateRevision
  ReplacementScope -->|"replaceDraftDocument / full replacement epoch"| EpochPublicRevision
  LoadSuccess -->|"load success epoch"| EpochPublicRevision
  EpochPublicRevision -->|"public runtime state domain"| RuntimeStateRevision
  RevisionState -.->|"structure/order changes"| StructuralRevision
  RevisionState -.->|"geometry/bounds changes"| BoundsRevision
  RevisionState -.->|"element visual changes"| ElementVisualRevision
  RevisionState -.->|"background document changes"| BackgroundRevision
  RevisionState -.->|"grid document changes"| GridRevision
  RevisionState -.->|"public projection invalidated"| ProjectionRevision
  RevisionState -.->|"resource descriptor changes"| ResourceRevision

  OrdinaryScope -->|"added or removed ids"| SpatialDelta
  OrdinaryScope -->|"geometry or transform changed ids"| SpatialDelta
  SpatialDelta -->|"apply removals and additions"| TouchedSpatialUpdate
  TouchedSpatialUpdate -->|"bounded candidate updates"| SpatialIndex
  TouchedSpatialUpdate -.->|"forbidden ordinary path"| SpatialFullClone
  ReplacementScope -->|"whole document changed"| SpatialRebuild
  EmptySpatialReset -->|"all elements removed"| SpatialRebuild
  LoadSuccess -->|"staged whole document replacement"| SpatialRebuild
  SpatialRebuild -->|"rebuild from committed tables"| SpatialIndex
  SpatialDelta -.->|"stale generation or invalid delta"| SpatialFallback
  SpatialFallback -.->|"candidate union > maxFallbackCandidates"| SpatialBudgetExceeded
  SpatialBudgetExceeded -.->|"schedule rebuild or retry outside hot path"| DeferredSpatialRepair

  ReplacementScope -->|"full projection eviction allowed"| ProjectionEvict
  LoadSuccess -->|"full projection eviction typed effect"| ProjectionEvict
  ProjectionRevision -->|"evict changed public projection entries"| ProjectionEvict
  ProjectionEvict -.->|"hot paths still use compact records"| NoProjectionHotPath

  ReplacementScope -->|"clear active resource session cache"| ResourceSessionInvalidation
  LoadSuccess -->|"clear active resource session cache typed effect"| ResourceSessionInvalidation
  ResourceRevision -->|"descriptor upsert/remove"| ResourceSessionInvalidation
  ResourceSessionInvalidation -->|"descriptor changed"| DescriptorCacheEvict
  DescriptorCacheEvict -->|"resource-dependent paint changed"| MainRepaint

  ResourceDirtyCall -->|"explicit external visual invalidation"| ResourceDirtyDispatch
  ResourceDirtyDispatch -->|"target/all active session entries before publication"| ResourceSessionInvalidation
  ResourceDirtyDispatch -->|"increment runtime resource visual revision"| ResourceVisualRevision
  ResourceVisualRevision -->|"public resource visual domain after invalidation"| ResourceVisualPublicRevision
  ResourceVisualPublicRevision -->|"public runtime state domain"| RuntimeStateRevision
  ResourceSessionInvalidation -->|"dirty target or all"| DirtyResourceEvict
  ResourceVisualRevision -->|"resource visuals changed"| MainRepaint
  ResourceVisualRevision -->|"main-only resource target"| SurfaceTargetAggregation
  ResourceDirtyCall -.->|"forbidden"| DirtyDocumentRevision
  ResourceDirtyCall -.->|"forbidden"| DirtySelectionPreview
  ResourceDirtyCall -.->|"forbidden"| DirtyActionEvent

  SelectionEffect -->|"membership changed"| SelectionRevision
  SelectionRevision -->|"public selection domain"| SelectionPublicRevision
  SelectionPublicRevision -->|"public runtime state domain"| RuntimeStateRevision
  SelectionRevision -->|"main-only selection target"| SurfaceTargetAggregation
  StructuralRevision -->|"structure/order changed"| PaintPlanInvalidation
  StructuralRevision -->|"main-only structure target"| SurfaceTargetAggregation
  BoundsRevision -->|"bounds changed"| PaintPlanInvalidation
  BoundsRevision -->|"main-only commit target"| SurfaceTargetAggregation
  BoundsRevision -->|"selection bounds changed"| SelectionDecorationInvalidation
  ElementVisualRevision -->|"element visual rows changed"| PaintPlanInvalidation
  ElementVisualRevision -->|"main-only visual target"| SurfaceTargetAggregation
  SelectionRevision -->|"selection changed"| SelectionDecorationInvalidation
  StructuralRevision -->|"selected chrome family may change"| SelectionDecorationInvalidation
  ReplacementScope -->|"full frame cache reset allowed"| PaintPlanInvalidation
  LoadSuccess -->|"full frame cache reset typed effect"| PaintPlanInvalidation
  ViewCameraCall -->|"runtime view camera only"| ViewCameraDispatch
  ViewCameraDispatch -->|"increment public view camera revision"| ViewCameraRevision
  ViewCameraRevision -->|"public runtime state domain"| RuntimeStateRevision
  ViewCameraDispatch -->|"view camera changed"| StaticFrameInvalidation
  ViewCameraDispatch -->|"view camera changed"| OverlayRepaint
  ViewCameraDispatch -->|"both-layer pre-output target"| SurfaceTarget
  InteractionConfigCall -->|"interaction settings changed"| InteractionConfigDispatch
  InteractionConfigDispatch -->|"increment public interaction revision"| InteractionPublicRevision
  InteractionPublicRevision -->|"public runtime state domain"| RuntimeStateRevision
  InteractionConfigDispatch -->|"selection changed by mode entry"| SelectionEffect
  InteractionConfigDispatch -->|"active preview cleared"| PreviewCleanup
  InteractionConfigDispatch -->|"pending preview style or cleanup target"| RuntimeRepaintEffects

  BackgroundRevision -->|"background document metadata only"| StaticFrameInvalidation
  BackgroundRevision -->|"main-only background target"| SurfaceTargetAggregation
  GridRevision -->|"grid document metadata only"| StaticFrameInvalidation
  GridRevision -->|"main-only grid target"| SurfaceTargetAggregation
  ElementVisualRevision -->|"changed text, path, or stroke inputs"| TextPathInvalidation
  PaintPlanInvalidation -->|"scene records changed"| MainRepaint
  SelectionDecorationInvalidation -->|"selection UI changed"| MainRepaint
  StaticFrameInvalidation -->|"background/grid/view camera frame changed"| MainRepaint
  TextPathInvalidation -->|"render cache entries changed"| MainRepaint

  PreviewCleanup -->|"preview state changes"| PreviewSnapshot
  LoadSuccess -->|"previewRevision if active preview cleared"| PreviewSnapshot
  PreviewSnapshot -->|"public preview domain when changed"| PreviewRevision
  PreviewRevision -->|"public runtime state domain"| RuntimeStateRevision
  PreviewSnapshot -->|"overlay preview\npreviewRevision + overlay repaint"| OverlayRepaint
  PreviewSnapshot -->|"selected move preview\npreviewRevision + main repaint"| MainRepaint
  LoadSuccess -->|"load success overlay repaint"| OverlayRepaint
  PreviewSnapshot -->|"preview-owned target meaning\naggregated by RuntimeRoot"| SurfaceTarget
  LoadSuccess -->|"both-layer pre-output target"| SurfaceTarget
  RuntimeRepaintEffects -->|"classified runtime repaint target"| SurfaceTargetAggregation
  SurfaceTargetAggregation -->|"runtime-owned target"| SurfaceTarget

  MainRepaint -.->|"output metadata after build"| FrameSignalBoundary
  OverlayRepaint -.->|"output metadata after build"| FrameSignalBoundary
  RuntimeStateRevision -->|"current runtime state"| SurfaceFrame
  SurfaceTarget -->|"targeted invalidation before output build"| SurfaceFrame
  SurfaceFrame -->|"active token listener"| Surface
  Surface -->|"apply target + local input keys"| OutputCache
  OutputCache -->|"build/publish if main targeted"| MainOutputNotifier
  OutputCache -->|"build/publish if overlay targeted"| OverlayOutputNotifier
  MainOutputNotifier --> MainPaintHost
  OverlayOutputNotifier --> OverlayPaintHost
