%% Resource resolution data flow
flowchart LR

  App["Application\nowns images and app keys"]
  Surface["CanvasSurface\npaint host with resourceResolver"]
  AppResolver["CanvasResourceResolver.resolveImage\nsynchronous app boundary"]

  subgraph PublicAPI["Public API"]
    EditCall["CanvasEdit mutation\nupsert/remove resource descriptors"]
    DirtyCall["CanvasResourcePort\nmarkResourceDirty / markAllResourcesDirty"]
  end

  subgraph Runtime["RuntimeRoot"]
    ResourceDirtyDispatch["Resource dirty orchestration\nResourceKernel delegation"]
  end

  subgraph Edit["EditKernel"]
    ResourceMutation["Resource descriptor mutation\ninside rollback-safe edit only"]
    CommitPlan["CommitPlan\nresource descriptor invalidation"]
  end

  subgraph Store["DocumentStoreKernel"]
    ResourceTable["Committed resource descriptor table\nCanvasImageResource"]
    AppKeyDescriptor["CanvasResourceSource.appKey only\nCanvasAppKeyResourceSource.key\nid, contentHash, byteLength,\nmimeType, CanvasMetadata"]
    DocumentRevision["documentRevision\nchanges only on committed descriptor mutation"]
    ResourceRevision["resourceRevision\ndescriptor version"]
    ProjectionRevision["projectionRevision\npublic document projection version"]
    ProjectionEvict["DocumentProjectionCache eviction\nresource descriptor is projected"]
  end

  subgraph FrameFactsPort["FrameFactsPort"]
    DescriptorFacts["Descriptor facts lookup\nresourceId -> immutable appKey descriptor + resourceRevision"]
  end

  subgraph Frame["FrameEngine"]
    MainPaint["Main paint frame\ncaptured once"]
    RenderRecords["Immutable RenderElementRecord list\nimage resource ids"]
    AssetRequest["Paint asset request\nresourceId -> descriptor"]
    PaintAsset["Paint asset\nui.Image or bounded placeholder"]
    MainRepaint["Main repaint request"]
  end

  subgraph PublicState["Public CanvasRuntimeState"]
    RuntimeStateRevision["state.revisions\npublic domains"]
    ResourceVisualState["resourceVisual"]
  end

  subgraph Session["SurfaceResourceSession"]
    ResolvePaintAsset["Resolve paint asset\nsession resolver boundary"]
    ImageResolveCache["ImageResolveCache\nresolverGeneration + resourceId + resourceRevision"]
    ResolverFrameBudget["Resolver frame budget\nkMaxSyncResourceResolverCallsPerFrame = 128"]
    MissingResult["Missing or unresolved result\nsuppressed for same frame key:\nresolverGeneration + resourceId + resourceRevision\nno immediate retry"]
    BudgetPlaceholder["Budget-exceeded placeholder\nnot cached as null/missing"]
    Placeholder["Bounded missing image placeholder"]
  end

  subgraph Resources["ResourceKernel"]
    ResourceVisualSignal["Resource visual revision\nResourceKernel runtime visual version"]
    SessionInvalidationEvent["Target/all invalidation event\nfor attached SurfaceResourceSession"]
  end

  subgraph Forbidden["Forbidden paths"]
    EngineIO["No engine IO\nno asset bundle, file, or network loading"]
    EngineDisposal["Engine never disposes\napp-owned ui.Image"]
    DirtyDocRevision["markResourceDirty does not increment\ndocumentRevision"]
    ResourcePortMutation["ResourcePort cannot mutate\nresource descriptors"]
    ResolverReentry["Resolver reentrant public mutation\nStateError, no runtime effects"]
  end

  App -->|"creates appKey descriptors through edit"| EditCall
  EditCall -->|"only mutation entry for descriptors"| ResourceMutation
  ResourceMutation -->|"draft resource table changes"| CommitPlan
  CommitPlan -->|"atomic install on success"| ResourceTable
  CommitPlan -->|"descriptor changed or removed"| ResourceRevision
  CommitPlan -->|"committed document state changed"| DocumentRevision
  CommitPlan -->|"public projection facts changed"| ProjectionRevision
  ProjectionRevision -->|"evict descriptor projection entries"| ProjectionEvict
  CommitPlan -->|"emit descriptor-dependent target/all invalidation event"| SessionInvalidationEvent
  ResourceTable -->|"stores source.kind = appKey only\npublic source is CanvasAppKeyResourceSource.key"| AppKeyDescriptor

  Surface -->|"main paint asks for records"| MainPaint
  MainPaint -->|"image elements carry resource ids"| RenderRecords
  RenderRecords -->|"resourceId"| AssetRequest
  AssetRequest -->|"request descriptor facts through FrameFactsPort"| DescriptorFacts
  DescriptorFacts -->|"resourceId lookup"| ResourceTable
  ResourceTable -->|"CanvasImageResource with CanvasAppKeyResourceSource.key"| DescriptorFacts
  DescriptorFacts -->|"descriptor snapshot + resourceRevision"| ResolvePaintAsset
  Surface -->|"owns active SurfaceResourceSession\nwith resolverGeneration"| ResolvePaintAsset

  ResolvePaintAsset -->|"cache lookup and bounded update"| ImageResolveCache
  ImageResolveCache -->|"cache hit: app-owned image"| ResolvePaintAsset
  ImageResolveCache -->|"cache miss"| ResolverFrameBudget
  ResolverFrameBudget -->|"budget available\nsync resolve request"| AppResolver
  ResolverFrameBudget -.->|"budget exceeded\nsession probe + at most one pending\nthrottled follow-up repaint"| BudgetPlaceholder
  BudgetPlaceholder -.->|"bounded placeholder\nno cache write"| PaintAsset
  AppResolver -->|"passes descriptor; app reads CanvasAppKeyResourceSource.key"| App
  AppResolver -->|"returns app-owned ui.Image or null\nno runtime mutation"| ResolvePaintAsset
  ResolvePaintAsset -->|"store resolved image\nby resolverGeneration + resourceId + resourceRevision"| ImageResolveCache
  ResolvePaintAsset -->|"resolved image"| PaintAsset
  ResolvePaintAsset -.->|"missing resource or null result"| MissingResult
  MissingResult -.->|"bounded placeholder result"| Placeholder
  Placeholder -.->|"placeholder paint asset"| PaintAsset
  PaintAsset -->|"assets only; no live resource mutation"| MainPaint

  App -->|"external image contents changed"| DirtyCall
  DirtyCall -->|"delegate dirty signal"| ResourceDirtyDispatch
  ResourceDirtyDispatch -->|"increment ResourceKernel visual revision only"| ResourceVisualSignal
  ResourceVisualSignal -->|"publish public resource visual domain"| ResourceVisualState
  ResourceVisualState -->|"public runtime state domain"| RuntimeStateRevision
  ResourceDirtyDispatch -->|"emit target/all invalidation event"| SessionInvalidationEvent
  SessionInvalidationEvent -->|"if attached, session invalidates target or all entries"| ImageResolveCache
  ResourceVisualSignal -->|"schedule main repaint"| MainRepaint
  MainRepaint --> Surface

  DirtyCall -.->|"forbidden"| DirtyDocRevision
  DirtyDocRevision -.->|"documentRevision unchanged"| DocumentRevision
  DirtyCall -.->|"forbidden"| ResourcePortMutation
  ResourcePortMutation -.->|"descriptor mutation must use CanvasEdit"| ResourceMutation
  AppResolver -.->|"forbidden"| ResolverReentry
  AppResolver -.->|"forbidden"| EngineIO
  AppResolver -.->|"forbidden"| EngineDisposal
