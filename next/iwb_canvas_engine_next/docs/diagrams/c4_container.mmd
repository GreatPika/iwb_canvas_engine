title iwb_canvas_engine_next container view
Person(Application, "Application", "Owns domain state")
System_Boundary(next_engine, "iwb_canvas_engine_next") {
  Container(PublicAPI, "Public API", "lib/src/api/", "Stable DTOs, operations, events, and errors.")
  Container(RuntimeRoot, "RuntimeRoot", "lib/src/runtime/", "Composition root for document, edit, interaction, frame, spatial, resource, codec, and diagnostic services.")
  Container(DocumentStoreKernel, "DocumentStoreKernel", "lib/src/store/", "Committed document state, revisions, selection, and resources.")
  Container(EditKernel, "EditKernel", "lib/src/edit/", "Synchronous edit sessions with draft, touched-set, commit, and rollback ownership.")
  Container(InteractionEngine, "InteractionEngine", "lib/src/interaction/", "Pointer sessions, tool state, previews, and terminal edit requests.")
  Container(FrameEngine, "FrameEngine", "lib/src/frame/", "Captured main and overlay frames, paint plans, and repaint buses.")
  Container(SpatialKernel, "SpatialKernel", "lib/src/spatial/", "Hit testing, bounds, and spatial indexes derived from document state.")
  Container(ResourceKernel, "ResourceKernel", "lib/src/resources/", "Resource descriptors, resolver cache, and invalidation.")
  Container(CodecBoundary, "CodecBoundary", "lib/src/codec/", "Schema v1 JSON decode, encode, migration, and diagnostics.")
  Container(DiagnosticsHub, "DiagnosticsHub", "lib/src/diagnostics/", "Structured validation, runtime, and migration error projection.")
}
