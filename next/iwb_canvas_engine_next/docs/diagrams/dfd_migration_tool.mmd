%% Migration tool data flow
flowchart LR

  Operator["Developer or release tooling"]
  OldFixtures["Old schema v7 fixtures\nlegacy saved documents"]
  AcceptedDifferences["Accepted differences registry\nold API not preserved,\nschema v7 not production target"]
  DonorReference["Legacy codec behavior\nreference only, no runtime dependency"]

  subgraph MigrationPackage["canvas_migration_tools package\ntooling only, outside production core"]
    ToolEntry["old_schema_v7_to_next_v1\nmigration command or library entry"]
    OldInputReader["Old fixture reader\nschema v7 input facts"]
    OldSchemaChecks["Old schema checks\nversion, root, known legacy shapes"]
    DifferencePolicy["Accepted difference policy\nexplicit mapping decisions only"]
    Mapper["v7 to v1 mapper\ncamera, background, grid,\npalette, layers, elements"]
    ImageResourceMapper["Image resource mapper\nimageId to CanvasImageResource\nsource.kind = appKey"]
    LossClassifier["Loss and warning classifier\nunsupported fields,\nintentional losses, warnings"]
    CandidateV1["Candidate schema v1 document\nJSON-compatible map"]
    ReportBuilder["MigrationReport builder\nversions, counts, created resources,\nunsupported fields, warnings, errors"]
    DataLossBuilder["DataLossReport builder\nall intentional losses"]
    ToolFailure["Tool failure\nno successful v1 output"]
  end

  subgraph SchemaV1Contract["Schema v1 contract validation\nv1 input only"]
    V1Validator["Schema v1 validator\nknown fields, resources,\nelements, references, metadata"]
    V1CanonicalEncoder["Canonical schema v1 encoder\nschemaVersion = 1"]
  end

  subgraph Outputs["Migration outputs"]
    SchemaV1Output["Validated schema v1 output\nMap or JSON file"]
    MigrationReport["MigrationReport\ninput v7, output v1,\nelement and resource counts"]
    DataLossReport["DataLossReport\nno silent data loss"]
    ErrorReport["Error report\nsafe diagnostics and failed mappings"]
  end

  subgraph ProductionCore["Production engine core"]
    ProductionCodec["Production decode/encode\nreads {1}, writes 1 only"]
    RuntimeRoot["RuntimeRoot and stores\nno migration code"]
  end

  subgraph Forbidden["Forbidden paths"]
    ProductionV7Read["No production schema v7 read"]
    LegacyImport["No import of legacy package\nor legacy runtime paths"]
    SilentLoss["No unreported loss\nor unsupported field drop"]
    LegacyFacade["No legacy facade\nSceneController, SceneSnapshot,\nNodeSpec, NodePatch, PatchField"]
    RuntimeMutation["No migration-time runtime mutation\nor committed store effects"]
  end

  Operator -->|"run migration"| ToolEntry
  OldFixtures -->|"old JSON fixtures"| ToolEntry
  AcceptedDifferences -->|"explicit allowed changes"| DifferencePolicy
  DonorReference -.->|"rewrite-reference evidence only"| DifferencePolicy

  ToolEntry -->|"read fixture"| OldInputReader
  OldInputReader -->|"legacy document facts"| OldSchemaChecks
  OldSchemaChecks -->|"schema v7 facts"| DifferencePolicy
  DifferencePolicy -->|"approved mappings"| Mapper
  Mapper -->|"element and document fields"| ImageResourceMapper
  ImageResourceMapper -->|"resource descriptors and element resourceIds"| CandidateV1
  Mapper -->|"unsupported or changed semantics"| LossClassifier
  DifferencePolicy -->|"accepted non-preservation decisions"| LossClassifier

  CandidateV1 -->|"validate as schema v1 only"| V1Validator
  V1Validator -->|"valid v1 facts"| V1CanonicalEncoder
  V1CanonicalEncoder -->|"canonical v1 JSON"| SchemaV1Output

  OldSchemaChecks -->|"input version and source counts"| ReportBuilder
  ImageResourceMapper -->|"created resources from imageId"| ReportBuilder
  V1Validator -->|"output version and validated counts"| ReportBuilder
  LossClassifier -->|"unsupported fields, warnings, errors"| ReportBuilder
  LossClassifier -->|"intentional losses"| DataLossBuilder
  ReportBuilder -->|"report artifact"| MigrationReport
  DataLossBuilder -->|"loss artifact"| DataLossReport

  OldSchemaChecks -.->|"invalid old fixture"| ToolFailure
  DifferencePolicy -.->|"unaccepted difference"| ToolFailure
  V1Validator -.->|"candidate is not valid v1"| ToolFailure
  ToolFailure -->|"failure details"| ErrorReport
  ToolFailure -->|"errors counted"| ReportBuilder

  ProductionCodec -->|"schema v1 document only"| RuntimeRoot
  SchemaV1Output -->|"later application input"| ProductionCodec

  OldFixtures -.->|"forbidden"| ProductionV7Read
  OldInputReader -.->|"forbidden"| ProductionCodec
  DonorReference -.->|"forbidden"| LegacyImport
  LossClassifier -.->|"forbidden"| SilentLoss
  DifferencePolicy -.->|"forbidden"| LegacyFacade
  ToolEntry -.->|"forbidden"| RuntimeMutation
  RuntimeRoot -.->|"forbidden dependency"| ToolEntry
