C4Component
title EditKernel code component view

Container(PublicAPI, "Public API", "lib/src/api/", "Stable edit and command ports that delegate to runtime.")
Container(RuntimeRoot, "RuntimeRoot", "lib/src/runtime/", "Coordinates edit and command entrypoints without exposing internals.")
Container(DocumentStoreKernel, "DocumentStoreKernel", "lib/src/store/", "Committed document tables, revisions, selection, resource descriptors, and projection cache.")
Container(DiagnosticsHub, "DiagnosticsHub", "lib/src/diagnostics/", "Structured validation and runtime error projection.")

Container_Boundary(edit_kernel, "EditKernel (lib/src/edit/)") {
  Component(EditSession, "EditSession", "session owner", "Rejects disposed, nested, async, and stale edit handles; owns callback lifetime.")
  Component(DraftDocument, "DraftDocument", "mutable draft", "Rollback-safe working copy created from the committed revision.")
  Component(TouchedSet, "TouchedSet", "change tracker", "Records exact document, geometry, visual, resource, selection, and replacement touches.")
  Component(CommitCompiler, "CommitCompiler", "commit compiler", "Compiles touched state, preflights invariants, prepares typed effects, and produces a CommitPlan.")
  Component(CommitPlan, "CommitPlan", "commit description", "Immutable commit payload with revisions, cache invalidation, repaint requests, and buffered events.")
  Component(CommitApplier, "CommitApplier", "atomic installer", "Installs committed changes only after a compiled and preflighted plan.")
}

Rel(PublicAPI, RuntimeRoot, "delegates edit(fn) or command mutation")
Rel(RuntimeRoot, EditSession, "opens synchronous edit session")
Rel(EditSession, DocumentStoreKernel, "reads committed revision")
Rel(EditSession, DraftDocument, "creates and closes")
Rel(DraftDocument, TouchedSet, "records mutations")
Rel(EditSession, CommitCompiler, "finalizes synchronous callback")
Rel(TouchedSet, CommitCompiler, "supplies exact invalidation inputs")
Rel(CommitCompiler, DocumentStoreKernel, "preflights invariants")
Rel(CommitCompiler, CommitPlan, "produces immutable commit plan")
Rel(CommitCompiler, CommitApplier, "hands off preflighted commit work")
Rel(CommitPlan, CommitApplier, "describes install payload")
Rel(CommitApplier, DocumentStoreKernel, "atomically installs committed state")
Rel(CommitApplier, DiagnosticsHub, "projects validation/runtime failures")
