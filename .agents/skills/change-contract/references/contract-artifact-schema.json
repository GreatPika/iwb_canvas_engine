{
  "version": 1,
  "vocabulary": "contract-vocabulary.json",
  "artifact_headings": {
    "contract": "Change Contract",
    "blocker": "Contract Blocker"
  },
  "contract_sections": [
    "Goal",
    "Source Inputs",
    "Classification",
    "Decision Trace",
    "Repository Evidence",
    "Boundaries",
    "Execution Units",
    "Verification Matrix",
    "Permanent Artifact Admissions",
    "Verification Gate"
  ],
  "blocker_sections": [
    "Goal",
    "Source Inputs",
    "Blocking Decisions",
    "Repository Evidence"
  ],
  "source_categories": ["Design", "Research", "PLAN", "Other"],
  "classification_fields": ["Profile", "Obligations"],
  "boundary_fields": [
    "Owner",
    "In Scope",
    "Out of Scope",
    "Source of Truth",
    "Compatibility",
    "Order Constraints",
    "Temporal Surface Closure",
    "All-Or-Nothing Failure Boundary",
    "Negative Proof And Fixture Quarantine",
    "Bounded Recognition Scope"
  ],
  "unit_fields": [
    "Owner",
    "Boundary",
    "Verification Profile",
    "Change",
    "Acceptance Outcomes",
    "Depends On"
  ],
  "admission_fields": [
    "Covers",
    "Impact",
    "Failure family",
    "Failure mode or stable invariant",
    "Verification owner",
    "Current verification gap",
    "Failing witness",
    "Durable and refactor-stable value",
    "Artifact target"
  ],
  "source_none_literal": "none",
  "source_user_request_literal": "user request",
  "source_repository_relative_pattern": "^(?!(?:[^/]+/)*\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
  "source_absolute_path_pattern": "^/(?!(?:[^/]+/)*\\.{1,2}(?:/|$))[^/\\r\\n\\\\]+(?:/[^/\\r\\n\\\\]+)*$",
  "form_none_literal": "None",
  "table_columns": {
    "Decision Trace": ["Decision ID", "Source decision", "Contract location", "Acceptance or evidence target"],
    "Acceptance Outcomes": ["Outcome key", "Starting state", "System action", "Observable result", "Required side conditions"],
    "Verification Matrix": ["Evidence key", "Covers", "Evidence class", "Evidence surface", "Pre-implementation witness", "Pass signal", "Evidence constraints and rejected proxy", "Durable impact", "Artifact target", "Admission"],
    "Verification Gate": ["Check", "Scope", "Future command or evidence", "Pass signal"],
    "Source Inputs": ["Category", "Source ID", "Location or authority"],
    "Blocking Decisions": ["Decision ID", "Blocking decision", "Blocks because", "Needed evidence or authority"]
  },
  "semantic_key_pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
  "evidence_classes": ["TEST", "STATIC_ANALYSIS", "BUILD_OR_COMPILE", "RUNTIME", "TEMPORARY_REPRODUCER", "STRUCTURED_DATA_CHECK", "SOURCE_QUERY", "MANUAL_INSPECTION"],
  "durable_impacts": ["NONE", "ADD", "EXTEND_COVERAGE", "UPDATE_EXISTING", "REDUCE_OR_REMOVE"],
  "unit_heading_pattern": "^### \\[ \\] Unit ([1-9][0-9]*): (.+)$",
  "admission_heading_pattern": "^### `([a-z][a-z0-9]*(?:-[a-z0-9]+)*)`: (.+)$",
  "dependency_pattern": "^- Unit ([1-9][0-9]*) — produces: (.+); consumed as: (.+)$",
  "required_gate_checks": ["Finding disposition", "Diff hygiene", "Lifecycle closure"],
  "required_gate_checks_by_obligation": {
    "COMMAND_REFERENCE_MIGRATION": ["Canonical route integrity"]
  },
  "template_marker_pattern": "\\{\\{[a-z][a-z0-9_]*\\}\\}",
  "template_marker_recognizer_pattern": "\\{\\{(?:(?!\\{\\{)[^\\r\\n])*\\}\\}",
  "template_markers": [
    "{{admission_entries_or_none}}",
    "{{admission_reference}}",
    "{{all_or_nothing_failure_boundary}}",
    "{{artifact_target}}",
